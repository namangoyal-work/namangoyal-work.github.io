---
/**
 * 404.astro — not-found page. noindex keeps it out of search results.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found" description="This page doesn't exist." noindex>
  <Nav />
  <main id="main" class="nf">
    <div class="container">
      <p class="nf__code">404</p>
      <h1 class="nf__title">This page doesn't exist.</h1>
      <p class="nf__text">
        The link may be old — the site was reorganized into separate pages.
        Try the <a class="link" href="/">home page</a>,
        <a class="link" href="/projects/">projects</a>, or
        <a class="link" href="/research/">research</a>.
      </p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    padding-top: calc(var(--nav-h) + clamp(48px, 10vw, 96px));
    padding-bottom: clamp(48px, 8vw, 80px);
    min-height: 60vh;
  }
  .nf__code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-faint);
    margin-bottom: 8px;
  }
  .nf__title { font-size: clamp(1.5rem, 4vw, 2rem); margin-bottom: 12px; }
  .nf__text { color: var(--text-muted); max-width: 50ch; }
</style>
