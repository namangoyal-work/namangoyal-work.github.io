---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { researchEntries } from "../data/research";
---

<Base
  title="Research — Naman Goyal"
  description="Research by Naman Goyal (IIT Delhi): quantum computing, and hardware supply-chain security of open-source RISC-V cores at CISPA Helmholtz Center."
>
  <PageHead
    label="Research"
    title="What I'm working on"
    lead="Quantum computing at IIT Delhi, and hardware supply-chain security at CISPA Helmholtz Center."
  />

  <div class="space-y-6">
    {
      researchEntries.map((r) => (
        <article class="panel px-6 py-7 sm:px-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 class="max-w-[34ch] text-[1.6rem] leading-tight">{r.title}</h2>
            <span class="meta">{r.period}</span>
          </div>

          <p class="mt-2 text-[0.92rem] u-muted">{r.org}</p>
          <p class="mt-2 flex flex-wrap items-center gap-2">
            <span class="chip">{r.role}</span>
            {r.status && <span class="chip" style="color: var(--accent-text); border-color: var(--accent-wash);">{r.status}</span>}
          </p>

          <p class="mt-5 text-[1rem] leading-[1.78] u-muted">{r.summary}</p>

          {r.points.length > 0 && (
            <ul class="mt-4 space-y-2">
              {r.points.map((pt) => (
                <li class="grid grid-cols-[1.15rem_1fr] text-[0.95rem] u-muted">
                  <span class="u-accent">·</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          )}

          <div class="mt-5 flex flex-wrap gap-1.5">{r.tags.map((t) => <span class="chip">{t}</span>)}</div>
        </article>
      ))
    }
  </div>
</Base>
