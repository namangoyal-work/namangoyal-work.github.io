---
/**
 * research.astro — the Research page: the flagship CISPA study in full,
 * plus lighter research-adjacent activities. Content lives in
 * src/data/research.ts.
 */
import Page from "../layouts/Page.astro";
import { research, activities } from "../data/research";
---

<Page
  title="Research"
  description="Naman Goyal's research: a large-scale study of the supply-chain security of open-source RISC-V CPU and GPU cores at CISPA Helmholtz Center for Information Security."
  lead="What I'm working on, and the questions I keep coming back to: whether the hardware we trust actually deserves it."
>
  <article class="study">
    <h2 class="study__title">{research.title}</h2>
    <p class="study__org">
      {research.org} · {research.role} · {research.period}
      {research.status && <span class="study__status">{research.status}</span>}
    </p>

    <p class="study__summary">{research.summary}</p>

    <ul class="study__points">
      {research.points.map((p) => <li>{p}</li>)}
    </ul>

    <div class="study__tags">
      {research.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
  </article>

  <section class="activities" aria-labelledby="activities-title">
    <h2 class="subhead" id="activities-title">Also involved in</h2>
    <ul class="activities__list">
      {activities.map((a) => (
        <li>
          <p class="activity__role">{a.role}</p>
          <p class="activity__org">{a.org}</p>
          <p class="activity__note">{a.note}</p>
        </li>
      ))}
    </ul>
  </section>
</Page>

<style>
  .study__title {
    font-size: 1.3rem;
    max-width: 34ch;
    margin-bottom: 8px;
  }
  .study__org {
    font-size: 0.9rem;
    color: var(--text-faint);
    margin-bottom: 20px;
  }
  .study__status {
    display: inline-block;
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 2px 9px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .study__summary {
    font-size: 1.02rem;
    margin-bottom: 18px;
    max-width: 70ch;
  }
  .study__points {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    margin-bottom: 22px;
  }
  .study__points li {
    position: relative;
    padding-left: 22px;
    color: var(--text-muted);
  }
  .study__points li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--text-faint);
  }
  .study__tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .activities { margin-top: clamp(36px, 6vw, 56px); }
  .subhead {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    font-weight: 500;
    margin-bottom: 16px;
  }
  .activities__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .activities__list li {
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .activities__list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .activity__role { font-weight: 600; font-size: 0.98rem; }
  .activity__org { color: var(--text-faint); font-size: 0.88rem; margin: 2px 0 6px; }
  .activity__note { color: var(--text-muted); font-size: 0.94rem; }
</style>
