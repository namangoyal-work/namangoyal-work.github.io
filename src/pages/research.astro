---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { researchEntries } from "../data/research";
---

<Base
  title="Research — Naman Goyal"
  description="Research by Naman Goyal (IIT Delhi): quantum computing, and hardware supply-chain security of open-source RISC-V cores at CISPA Helmholtz Center."
>
  <PageHead
    title="Research"
    lead="Quantum computing at IIT Delhi, and hardware security at CISPA Helmholtz Center."
  />

  <div class="space-y-14">
    {
      researchEntries.map((r) => (
        <article>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 class="max-w-[38ch] text-[1.15rem] leading-snug">{r.title}</h2>
            <span class="font-mono text-[0.76rem] text-faint">{r.period}</span>
          </div>

          <p class="mt-1.5 text-[0.9rem] text-muted">{r.org}</p>
          <p class="mt-0.5 font-mono text-[0.76rem] text-faint">
            {r.role}
            {r.status && <> · {r.status}</>}
          </p>

          <p class="mt-4 text-[0.97rem] leading-[1.75] text-muted">{r.summary}</p>

          {r.points.length > 0 && (
            <ul class="mt-4 space-y-2">
              {r.points.map((pt) => (
                <li class="grid grid-cols-[1.15rem_1fr] text-[0.94rem] text-muted">
                  <span class="text-faint">—</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          )}

          <p class="mt-4 font-mono text-[0.72rem] text-faint">{r.tags.join(" · ")}</p>
        </article>
      ))
    }
  </div>
</Base>
