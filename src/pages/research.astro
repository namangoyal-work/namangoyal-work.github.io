---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { researchEntries } from "../data/research";
---

<Base
  title="Research — Naman Goyal"
  description="Research by Naman Goyal (IIT Delhi): quantum computing, and hardware supply-chain security of open-source RISC-V cores at CISPA Helmholtz Center."
>
  <header class="text-center">
    <h1 class="text-[1.7rem] font-extrabold tracking-[-0.02em]">Research</h1>
    <p class="mt-1 text-[0.9rem] u-faint">// quantum computing, and the security of open hardware.</p>
  </header>

  {
    researchEntries.map((r) => (
      <Section title={r.title}>
        <p class="text-[0.88rem] u-faint">
          {r.org}
        </p>
        <p class="mt-0.5 text-[0.88rem] u-faint">
          {r.role}
          {r.advisor && <> &middot; advised by {r.advisor}</>}
          &middot; {r.period}
          {r.status && <> &middot; {r.status}</>}
        </p>

        <p class="prose-j mt-4">{r.summary}</p>

        {r.points.length > 0 && (
          <ul class="mt-4 space-y-1.5">
            {r.points.map((pt) => (
              <li class="grid grid-cols-[1.4rem_1fr] u-muted">
                <span class="u-faint">-</span>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        )}

        <p class="mt-4 text-[0.82rem] u-faint">{r.tags.join(" · ")}</p>

        {r.links && (
          <ul class="mt-3 space-y-1">
            {r.links.map((l) => (
              <li class="text-[0.85rem]">
                <a class="a" href={l.href} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              </li>
            ))}
          </ul>
        )}
      </Section>
    ))
  }
</Base>
