---
/**
 * index.astro — the home page: who I am, what's new, highlights.
 * The deep content lives on its own pages: /research/, /projects/,
 * /achievements/.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Intro from "../components/Intro.astro";
import News from "../components/News.astro";
import SelectedWork from "../components/SelectedWork.astro";
import ResearchSnapshot from "../components/ResearchSnapshot.astro";
import Background from "../components/Background.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main id="main">
    <Intro />
    <News />
    <ResearchSnapshot />
    <SelectedWork />
    <Background />
  </main>
  <Footer />
</Base>
