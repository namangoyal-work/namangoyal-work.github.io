---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { experience } from "../data/experience";
import { education, skillGroups } from "../data/about";
import { site } from "../data/site";
---

<Base
  title="CV — Naman Goyal"
  description="Curriculum vitae of Naman Goyal: Electrical Engineering at IIT Delhi (Dept. Rank 1), research at CISPA Helmholtz Center, incoming quantitative software engineering intern at Virtu Financial."
>
  <header class="text-center">
    <h1 class="text-[1.7rem] font-extrabold tracking-[-0.02em]">Curriculum Vitae</h1>
    <p class="mt-1 text-[0.9rem] u-faint">// education, experience, skills.</p>
    <p class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-1 text-[0.85rem]">
      {/* Two paths on purpose: most people want to glance at it, not commit
          a file to their downloads folder. `view` opens the browser's PDF
          reader in a new tab; `download` forces the save with the download
          attribute (same-origin, so it works). */}
      <a class="b" href={site.resume} target="_blank" rel="noopener">view pdf</a>
      <a class="b" href={site.resume} download>download</a>
    </p>
  </header>

  <Section title="Education">
    {
      education.map((e) => (
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="font-bold">{e.org}</h3>
            <span class="text-[0.82rem] u-faint">{e.meta.split("·")[0].trim()}</span>
          </div>
          <p class="mt-0.5 u-muted">{e.detail}</p>
          <p class="mt-0.5 text-[0.85rem] u-faint">{e.meta.split("·").slice(1).join(" ·").trim()}</p>
          {e.honors && <p class="prose-j mt-1.5 u-muted">{e.honors}</p>}
        </div>
      ))
    }
  </Section>

  <Section title="Experience">
    <ul class="space-y-7">
      {
        experience.map((r) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-bold">
                {r.org}
                {r.upcoming && <span class="ml-2 text-[0.78rem] font-normal u-faint">[incoming]</span>}
              </h3>
              <span class="text-[0.82rem] u-faint">{r.period}</span>
            </div>
            <p class="mt-0.5 u-muted">
              {r.title}
              {r.location && <span class="u-faint"> &middot; {r.location}</span>}
            </p>

            {r.points.length > 0 && (
              <ul class="mt-2 space-y-1.5">
                {r.points.map((pt) => (
                  <li class="grid grid-cols-[1.4rem_1fr] u-muted">
                    <span class="u-faint">-</span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title="Technical Skills">
    <dl class="space-y-2">
      {
        skillGroups.map((g) => (
          <div class="row row--wide">
            <dt class="u-faint">[{g.label.split(" ")[0].toLowerCase()}]</dt>
            <dd class="u-muted">{g.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section title="Contact">
    <p class="prose-j u-muted">
      Open to research collaborations and conversations about low-latency systems and quantum computing. Email is the
      fastest way to reach me.
    </p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[0.85rem]">
      <a class="b" href={`mailto:${site.email}`}>email</a>
      <a class="b" href={site.socials.github} target="_blank" rel="noopener">github</a>
      <a class="b" href={site.socials.linkedin} target="_blank" rel="noopener">linkedin</a>
    </p>
  </Section>
</Base>
