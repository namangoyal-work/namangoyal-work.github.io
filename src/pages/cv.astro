---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { experience } from "../data/experience";
import { education, skillGroups } from "../data/about";
import { site } from "../data/site";
---

<Base
  title="CV — Naman Goyal"
  description="Curriculum vitae of Naman Goyal: Electrical Engineering at IIT Delhi (Dept. Rank 1), research at CISPA Helmholtz Center, incoming quantitative software engineering intern at Virtu Financial."
>
  <PageHead title="Curriculum Vitae" lead="Education, experience and technical skills.">
    <p class="mt-4 text-[0.88rem]">
      <a class="link" href="/resume" target="_blank" rel="noopener">Download the PDF ↗</a>
    </p>
  </PageHead>

  <section>
    <h2 class="label border-b rule pb-2">Education</h2>
    <div class="mt-5 space-y-5">
      {
        education.map((e) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6">
              <h3 class="text-[1rem] font-semibold">{e.org}</h3>
              <span class="font-mono text-[0.76rem] text-faint">{e.meta.split("·")[0].trim()}</span>
            </div>
            <p class="mt-0.5 text-[0.94rem] text-muted">{e.detail}</p>
            <p class="mt-0.5 font-mono text-[0.76rem] text-faint">
              {e.meta.split("·").slice(1).join(" ·").trim()}
            </p>
            {e.honors && <p class="mt-1.5 text-[0.92rem] text-muted">{e.honors}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-14">
    <h2 class="label border-b rule pb-2">Experience</h2>
    <div class="mt-5 space-y-9">
      {
        experience.map((r) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-[1rem] font-semibold">
                {r.org}
                {r.upcoming && <span class="ml-2 font-mono text-[0.68rem] uppercase tracking-wider text-faint">incoming</span>}
              </h3>
              <span class="font-mono text-[0.76rem] text-faint">{r.period}</span>
            </div>
            <p class="mt-0.5 text-[0.94rem] text-muted">
              {r.title}
              {r.location && <span class="text-faint"> · {r.location}</span>}
            </p>

            {r.points.length > 0 && (
              <ul class="mt-3 space-y-2">
                {r.points.map((pt) => (
                  <li class="grid grid-cols-[1.15rem_1fr] text-[0.93rem] text-muted">
                    <span class="text-faint">—</span>
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-14">
    <h2 class="label border-b rule pb-2">Technical skills</h2>
    <dl class="mt-5 space-y-4">
      {
        skillGroups.map((g) => (
          <div class="grid grid-cols-[9rem_1fr] gap-x-4 max-sm:grid-cols-1 max-sm:gap-y-0.5">
            <dt class="pt-0.5 font-mono text-[0.74rem] uppercase tracking-wider text-faint">{g.label}</dt>
            <dd class="text-[0.94rem] text-muted">{g.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mt-14">
    <h2 class="label border-b rule pb-2">Contact</h2>
    <p class="mt-5 text-[0.94rem] text-muted">
      Open to research collaborations and conversations about low-latency systems and quantum computing.
      Email is the fastest way to reach me.
    </p>
    <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[0.9rem]">
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="link" href={site.socials.github} target="_blank" rel="noopener">GitHub</a>
      <a class="link" href={site.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </p>
  </section>
</Base>
