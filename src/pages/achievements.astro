---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { achievementPhases } from "../data/achievements";
---

<Base
  title="Achievements — Naman Goyal"
  description="Awards and honours: CISPA European AI & Cybersecurity Hackathon champion, Atlassian FastTrack winner, Dept. Rank 1 at IIT Delhi, USACO Platinum with a perfect 1000/1000, INPhO and INAO golds, INMO."
>
  <header class="text-center">
    <h1 class="text-[1.7rem] font-extrabold tracking-[-0.02em]">Achievements</h1>
    <p class="mt-1 text-[0.9rem] u-faint">// every entry here is certificate-verified.</p>
  </header>

  {
    achievementPhases.map((phase) =>
      phase.groups.map((g) => (
        <Section title={`${phase.phase} — ${g.heading}`}>
          <ul class="space-y-4">
            {g.items.map((a) => (
              <li class="row row--wide">
                <span class="u-faint">[{a.badge}]</span>
                <div>
                  <p class="font-bold">{a.title}</p>
                  <p class="prose-j mt-0.5 u-muted">{a.detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </Section>
      )),
    )
  }
</Base>
