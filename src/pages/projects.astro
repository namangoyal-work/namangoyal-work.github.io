---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";
---

<Base
  title="Projects — Naman Goyal"
  description="Selected engineering work by Naman Goyal: an FPGA tick-to-trade pipeline, a low-latency C++ execution engine, a wire-speed packet parser, and a Solovay–Kitaev decomposer."
>
  <header class="text-center">
    <h1 class="text-[1.7rem] font-extrabold tracking-[-0.02em]">Projects</h1>
    <p class="mt-1 text-[0.9rem] u-faint">// a short list on purpose. everything else is on github.</p>
  </header>

  <Section title="Selected Work">
    <ul class="space-y-8">
      {
        projects.map((p) => (
          <li>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-bold">{p.title}</h3>
              <span class="text-[0.82rem] u-faint">
                {p.kind} &middot; {p.year}
              </span>
            </div>
            <p class="prose-j mt-2 u-muted">{p.blurb}</p>
            <p class="mt-2 flex flex-wrap items-center gap-x-3 text-[0.82rem]">
              <span class="u-faint">{p.tags.join(" · ")}</span>
              {p.repo && (
                <a class="b" href={p.repo} target="_blank" rel="noopener">
                  code
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="sep mt-10 pt-6 u-muted">
      Coursework, experiments and everything not listed here lives on{" "}
      <a class="a" href={site.socials.github} target="_blank" rel="noopener">
        github
      </a>.
    </p>
  </Section>
</Base>
