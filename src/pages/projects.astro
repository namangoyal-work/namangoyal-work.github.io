---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";
---

<Base
  title="Projects — Naman Goyal"
  description="Selected engineering work by Naman Goyal: an FPGA tick-to-trade pipeline, a low-latency C++ execution engine, a wire-speed packet parser, and a Solovay–Kitaev decomposer."
>
  <PageHead
    label="Projects"
    title="Selected work"
    lead="A short list on purpose — the work I'd defend line by line. Everything else is on GitHub."
  />

  <div class="space-y-4">
    {
      projects.map((p) => (
        <article class="panel panel-hover px-6 py-6 sm:px-7">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 class="text-[1.5rem] leading-tight">{p.title}</h2>
            <span class="meta">
              {p.kind} · {p.year}
            </span>
          </div>

          <p class="mt-4 text-[1rem] leading-[1.78] u-muted">{p.blurb}</p>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap gap-1.5">
              {p.tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
            {p.repo && (
              <a class="link text-[0.84rem]" href={p.repo} target="_blank" rel="noopener">
                Source ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-12 border-t u-line pt-6 text-[0.94rem] u-muted">
    Coursework, experiments and everything not listed here lives on{" "}
    <a class="link" href={site.socials.github} target="_blank" rel="noopener">GitHub ↗</a>.
  </p>
</Base>
