---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";
---

<Base
  title="Projects — Naman Goyal"
  description="Selected engineering work by Naman Goyal: an FPGA tick-to-trade pipeline, a low-latency C++ execution engine, a wire-speed packet parser, and a Solovay–Kitaev decomposer."
>
  <PageHead
    title="Projects"
    lead="A short list on purpose — the work I'd defend line by line. Everything else is on GitHub."
  />

  <div class="space-y-12">
    {
      projects.map((p) => (
        <article>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h2 class="text-[1.1rem] leading-snug">{p.title}</h2>
            <span class="font-mono text-[0.76rem] text-faint">
              {p.kind} · {p.year}
            </span>
          </div>

          <p class="mt-3 text-[0.97rem] leading-[1.75] text-muted">{p.blurb}</p>

          <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
            <p class="font-mono text-[0.72rem] text-faint">{p.tags.join(" · ")}</p>
            {p.repo && (
              <a class="link text-[0.82rem]" href={p.repo} target="_blank" rel="noopener">
                Source ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-14 border-t rule pt-6 text-[0.92rem] text-muted">
    Coursework, experiments and everything not listed here lives on{" "}
    <a class="link" href={site.socials.github} target="_blank" rel="noopener">GitHub ↗</a>.
  </p>
</Base>
