---
/**
 * Hero.astro — name, position, one factual paragraph, links.
 *
 * Deliberately undecorated: no gradient mesh, no cursor spotlight, no
 * animated scroll cue. On a page whose job is to make a hiring manager
 * take you seriously, restraint reads as confidence and ornament reads
 * as noise. Hierarchy is carried by type size and hairline rules only.
 */
import { site } from "../data/site";
import { focusAreas } from "../data/about";
---

<section class="hero" id="top">
  <div class="container hero__inner" data-stagger>
    <h1 class="hero__name">{site.name}</h1>

    <p class="hero__role">{site.role}</p>
    <p class="hero__status">{site.status}</p>

    <p class="hero__lead">{site.subhead}</p>

    <div class="hero__cta">
      <a class="btn btn--primary" href="#projects">Selected work</a>
      <a class="btn btn--ghost" href={site.resume} target="_blank" rel="noopener">Résumé</a>
      <a class="btn btn--ghost" href="#contact">Contact</a>
    </div>

    <ul class="hero__focus">
      {focusAreas.map((f) => <li>{f}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: calc(var(--nav-h) + clamp(64px, 11vh, 120px)) clamp(56px, 9vh, 96px);
    border-bottom: 1px solid var(--border);
  }

  .hero__name {
    font-size: clamp(2.4rem, 6vw, 3.9rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-bottom: 18px;
  }

  /* Position lines: monospace, because they are facts, not a tagline. */
  .hero__role,
  .hero__status {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .hero__status { color: var(--text-faint); }

  .hero__lead {
    margin-top: 26px;
    padding-top: 26px;
    border-top: 1px solid var(--border);
    max-width: 62ch;
    font-size: 1.06rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .hero__focus {
    list-style: none; display: flex; flex-wrap: wrap;
    padding: 0; margin-top: 40px;
    font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-faint);
  }
  /* Separated by rules rather than boxed into pills. */
  .hero__focus li + li { margin-left: 14px; padding-left: 14px; border-left: 1px solid var(--border); }

  @media (max-width: 640px) {
    .hero__cta { flex-direction: column; align-items: stretch; }
    .hero__focus { gap: 6px 0; }
    .hero__focus li + li { margin-left: 12px; padding-left: 12px; }
  }
</style>
