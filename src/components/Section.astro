---
/**
 * Section.astro — a `/* Title *\/` heading with its content beneath.
 * The comment markers come from CSS, so the markup stays semantic.
 */
interface Props {
  title: string;
  class?: string;
}
const { title, class: cls } = Astro.props;
---

<section class:list={["mt-12", cls]}>
  <h2 class="sec">{title}</h2>
  <div class="mt-5">
    <slot />
  </div>
</section>
