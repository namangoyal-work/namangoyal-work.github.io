---
/**
 * Background.astro — education, skills, and interests on the home page.
 * Content comes from about.ts.
 */
import { education, skillGroups, interests } from "../data/about";
---

<section class="section" aria-labelledby="background-title">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title" id="background-title">Background</h2>
    </header>

    <div class="cols">
      <div>
        <h3 class="subhead">Education</h3>
        <ul class="edu">
          {education.map((e) => (
            <li>
              <p class="edu__org">{e.org}</p>
              <p class="edu__detail">{e.detail}</p>
              <p class="edu__meta">{e.meta}</p>
              {e.honors && <p class="edu__honors">{e.honors}</p>}
            </li>
          ))}
        </ul>

        <h3 class="subhead">Beyond engineering</h3>
        <p class="interests">{interests.join(" · ")}</p>
      </div>

      <div>
        <h3 class="subhead">Skills &amp; tools</h3>
        {skillGroups.map((g) => (
          <div class="skills__group">
            <p class="skills__label">{g.label}</p>
            <div class="skills__chips">
              {g.items.map((s) => <span class="chip">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
    align-items: start;
  }
  .subhead {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    font-weight: 500;
    margin-bottom: 14px;
  }
  .subhead:not(:first-child) { margin-top: 32px; }

  .edu { list-style: none; padding: 0; }
  .edu__org { font-weight: 600; }
  .edu__detail { color: var(--text-muted); font-size: 0.94rem; }
  .edu__meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-top: 4px;
  }
  .edu__honors {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 6px;
  }
  .interests { color: var(--text-muted); font-size: 0.94rem; }

  .skills__group { margin-bottom: 16px; }
  .skills__label {
    font-size: 0.84rem;
    color: var(--text-muted);
    font-weight: 550;
    margin-bottom: 8px;
  }
  .skills__chips { display: flex; flex-wrap: wrap; gap: 6px; }

  @media (max-width: 680px) {
    .cols { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
