---
/**
 * News.astro — dated updates on the home page. Data lives in src/data/news.ts;
 * prepend a new item there and it shows up here.
 */
import { news } from "../data/news";
---

<section class="section" aria-labelledby="news-title">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title" id="news-title">News</h2>
    </header>

    <dl class="news">
      {news.map((n) => (
        <div class="news__row">
          <dt class="news__date">{n.date}</dt>
          <dd class="news__text">
            {n.text}
            {n.href && n.linkText && (
              <>
                {" "}
                <a class="link" href={n.href}>{n.linkText} →</a>
              </>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .news {
    display: grid;
    gap: 14px;
  }
  .news__row {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 16px;
    align-items: baseline;
  }
  .news__date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    white-space: nowrap;
  }
  .news__text {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.96rem;
  }

  @media (max-width: 560px) {
    .news__row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .news { gap: 18px; }
  }
</style>
