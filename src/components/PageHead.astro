---
/**
 * PageHead.astro — the heading block every inner page opens with.
 * Title, optional one-line lead, hairline rule. Nothing else.
 */
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<header class="mb-12 border-b rule pb-6">
  <h1 class="text-[1.75rem] sm:text-[2rem]">{title}</h1>
  {lead && <p class="mt-3 max-w-[54ch] text-[0.98rem] text-muted">{lead}</p>}
  <slot />
</header>
