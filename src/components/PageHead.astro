---
/**
 * PageHead.astro — the heading block every inner page opens with:
 * mono label, serif title, lead, accent rule.
 */
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<header class="mb-14">
  <p class="label">{label}</p>
  <h1 class="mt-3 text-[2.6rem] sm:text-[3.2rem]">{title}</h1>
  {lead && <p class="mt-4 max-w-[58ch] text-[1.02rem] u-muted">{lead}</p>}
  <slot />
  <div class="accent-rule mt-8"></div>
</header>
