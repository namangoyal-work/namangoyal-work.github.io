---
/**
 * Intro.astro — the top of the home page: name, role, short bio, and the
 * primary contact links. Content comes from site.ts and about.ts.
 */
import { site } from "../data/site";
import { aboutParagraphs } from "../data/about";

const links = [
  { label: "Email", href: `mailto:${site.email}` },
  { label: "GitHub", href: site.socials.github },
  { label: "LinkedIn", href: site.socials.linkedin },
  { label: "Résumé", href: site.resume },
];
---

<section class="intro">
  <div class="container">
    <h1 class="intro__name">{site.name}</h1>
    <p class="intro__role">
      {site.role} · Research Intern @ CISPA Helmholtz Center
    </p>

    <p class="intro__headline">{site.headline}</p>

    {aboutParagraphs.map((p) => <p class="intro__p">{p}</p>)}

    <ul class="intro__links">
      {links.map((l) => (
        <li>
          <a
            class="link"
            href={l.href}
            target={l.href.startsWith("http") || l.href.endsWith(".pdf") ? "_blank" : undefined}
            rel={l.href.startsWith("http") ? "noopener" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro {
    padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 72px));
    padding-bottom: clamp(16px, 3vw, 24px);
  }
  .intro__name {
    font-size: clamp(2rem, 5vw, 2.6rem);
    letter-spacing: -0.025em;
    margin-bottom: 6px;
  }
  .intro__role {
    color: var(--text-muted);
    font-size: 0.98rem;
    margin-bottom: 26px;
  }
  .intro__headline {
    font-size: 1.15rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    max-width: 48ch;
  }
  .intro__p {
    color: var(--text-muted);
    margin-bottom: 14px;
    max-width: 64ch;
  }
  .intro__links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 22px;
    font-size: 0.95rem;
  }
</style>
