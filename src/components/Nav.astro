---
/**
 * Nav.astro — sticky, blurred, with an amber dot marking the current page.
 */
import { site } from "../data/site";

const pages = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/achievements", label: "Achievements" },
  { href: "/cv", label: "CV" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header
  class="sticky top-0 z-40 border-b u-line backdrop-blur-xl"
  style="background: color-mix(in srgb, var(--bg) 82%, transparent);"
>
  <div class="mx-auto flex w-full max-w-[52rem] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3.5 sm:px-8">
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="grid h-7 w-7 place-items-center rounded-md text-[0.66rem] font-semibold tracking-tight text-black"
        style="background: var(--accent);">NG</span
      >
      <span class="text-[0.92rem] font-medium tracking-tight">{site.name}</span>
    </a>

    <nav class="flex items-center gap-x-1" aria-label="Primary">
      {
        pages.map((p) => (
          <a
            href={p.href}
            aria-current={isActive(p.href) ? "page" : undefined}
            class="relative rounded-md px-2.5 py-1.5 text-[0.83rem] transition-colors"
            style={isActive(p.href) ? "color: var(--text); background: var(--accent-wash);" : "color: var(--muted);"}
          >
            {p.label}
          </a>
        ))
      }

      <button
        data-theme-toggle
        type="button"
        class="ml-1 grid h-8 w-8 place-items-center rounded-md border u-line transition-colors"
        style="color: var(--faint);"
        aria-label="Toggle dark mode"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>
