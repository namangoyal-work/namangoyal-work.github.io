---
/**
 * Nav.astro — name on the left, pages on the right. Text only.
 * The current page is marked with an underline, not a colour.
 */
import { site } from "../data/site";

const pages = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/projects", label: "Projects" },
  { href: "/achievements", label: "Achievements" },
  { href: "/cv", label: "CV" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b rule py-5">
  <a href="/" class="text-[0.95rem] font-semibold tracking-tight">{site.name}</a>

  <nav class="flex items-center gap-x-5 text-[0.85rem]" aria-label="Primary">
    {
      pages.map((p) => (
        <a
          href={p.href}
          aria-current={isActive(p.href) ? "page" : undefined}
          class:list={[
            "pb-0.5 transition-colors",
            isActive(p.href)
              ? "border-b border-current"
              : "text-muted hover:text-[var(--color-ink)] dark:hover:text-[var(--color-ink-dark)]",
          ]}
        >
          {p.label}
        </a>
      ))
    }

    <button
      data-theme-toggle
      type="button"
      class="text-faint transition-colors hover:text-[var(--color-ink)] dark:hover:text-[var(--color-ink-dark)]"
      aria-label="Toggle dark mode"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
      </svg>
    </button>
  </nav>
</header>
