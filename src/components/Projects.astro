---
/**
 * Projects.astro — the home-page Projects section. Shows ONLY the projects
 * marked `featured: true` in src/data/projects.ts; everything else lives on
 * the /projects/ archive page. Cards render at equal size here (the
 * `featured` span is an archive-page affordance), so the section stays a
 * tight, scannable grid.
 */
import { projects } from "../data/projects";
import { site } from "../data/site";
import ProjectCard from "./ProjectCard.astro";

const featured = projects
  .filter((p) => p.featured)
  .map((p) => ({ ...p, featured: false }));
---

<section class="section" id="projects">
  <div class="container">
    <header class="section__head reveal">
      <span class="eyebrow">03 — Projects</span>
      <h2 class="section__title">Selected work, from nanoseconds to qubits.</h2>
      <p class="section__lead">
        The projects I'd want a recruiter to open first — low-latency trading systems on FPGAs,
        formally verified hardware, and physics-informed ML.
      </p>
    </header>

    <div class="grid" data-stagger>
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>

    <p class="more reveal">
      <a class="more__archive" href="/projects/">Browse all projects →</a>
      <span class="more__sep">·</span>
      <a href={site.socials.github} target="_blank" rel="noopener">GitHub&nbsp;↗</a>
    </p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

  .more { margin-top: 28px; color: var(--text-muted); display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .more a { color: var(--accent-ink); font-weight: 500; }
  .more__archive { font-size: 1.02rem; }
  .more__sep { color: var(--text-faint); }

  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
