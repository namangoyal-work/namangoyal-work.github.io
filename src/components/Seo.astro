---
/**
 * Seo.astro — all <head> SEO in one place.
 * Meta tags, Open Graph, Twitter cards, identity (rel=me), and a JSON-LD
 * @graph (Person + WebSite + ProfilePage) so search engines can build a
 * rich result for the name "Naman Goyal".
 */
import { site } from "../data/site";
import { achievementPhases } from "../data/achievements";

interface Props {
  /** Per-page <title>; falls back to the site-wide default. */
  title?: string;
  /** Per-page meta description; falls back to the site-wide default. */
  description?: string;
  /** Keep this page out of the index (404s, thin utility pages). */
  noindex?: boolean;
}

const { title = site.seo.title, description = site.seo.description, noindex = false } = Astro.props;

const base = Astro.site?.href ?? "https://namangoyal-work.github.io/";
const canonical = new URL(Astro.url.pathname, base).href;
const isHome = Astro.url.pathname === "/";
const ogImage = new URL(site.seo.ogImage, base).href;

// Flatten the achievements data into schema.org Person.award entries, so the
// structured data stays in sync with the visible Recognition section — a
// richer Person entity helps Google build a knowledge panel for the name.
const awards = achievementPhases.flatMap((phase) =>
  phase.groups.flatMap((g) => g.items.map((a) => `${a.title} — ${a.badge}`)),
);

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${base}#person`,
      name: site.name,
      url: base,
      image: ogImage,
      email: `mailto:${site.email}`,
      givenName: "Naman",
      familyName: "Goyal",
      jobTitle: "Electrical Engineering Student",
      description: site.seo.description,
      // `affiliation` is the correct relation for a *current* student;
      // `alumniOf` stays because Google still reads it for the education edge.
      affiliation: {
        "@type": "CollegeOrUniversity",
        name: "Indian Institute of Technology Delhi",
        alternateName: ["IIT Delhi", "IITD"],
        sameAs: "https://home.iitd.ac.in/",
      },
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Indian Institute of Technology Delhi",
        sameAs: "https://home.iitd.ac.in/",
      },
      // Named organisations are strong disambiguation signals for a common
      // name — they give the entity edges nobody else called Naman Goyal has.
      hasOccupation: {
        "@type": "Occupation",
        name: "Software Engineer",
        occupationalCategory: "15-1252.00",
        skills: "Quantum computing, low-latency C++, FPGA / SystemVerilog, algorithms",
      },
      homeLocation: { "@type": "Place", name: site.location },
      nationality: { "@type": "Country", name: "India" },
      knowsAbout: site.seo.keywords,
      knowsLanguage: ["en", "hi"],
      award: awards,
      mainEntityOfPage: { "@id": base },
      sameAs: [site.socials.github, site.socials.linkedin, ...site.profiles],
    },
    {
      "@type": "WebSite",
      "@id": `${base}#website`,
      url: base,
      name: site.name,
      description: site.seo.description,
      publisher: { "@id": `${base}#person` },
      inLanguage: "en",
    },
    // The home page is a ProfilePage about the Person (mainEntity is the
    // field Google requires — `about` alone isn't enough). Subpages are
    // plain WebPages with a breadcrumb back home.
    isHome
      ? {
          "@type": "ProfilePage",
          "@id": canonical,
          url: canonical,
          name: title,
          isPartOf: { "@id": `${base}#website` },
          mainEntity: { "@id": `${base}#person` },
          about: { "@id": `${base}#person` },
          inLanguage: "en",
        }
      : {
          "@type": "WebPage",
          "@id": canonical,
          url: canonical,
          name: title,
          description,
          isPartOf: { "@id": `${base}#website` },
          about: { "@id": `${base}#person` },
          inLanguage: "en",
          breadcrumb: {
            "@type": "BreadcrumbList",
            itemListElement: [
              { "@type": "ListItem", position: 1, name: "Home", item: base },
              { "@type": "ListItem", position: 2, name: title, item: canonical },
            ],
          },
        },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta name="keywords" content={site.seo.keywords.join(", ")} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={
    noindex
      ? "noindex, nofollow"
      : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  }
/>
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#08080b" media="(prefers-color-scheme: dark)" />
{site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
{site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}

<!-- Identity: rel=me links help search engines connect your profiles. -->
<link rel="me" href={site.socials.github} />
<link rel="me" href={site.socials.linkedin} />
<link rel="author" href={base} />

<!-- Open Graph -->
<meta property="og:type" content={isHome ? "profile" : "website"} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
{isHome && <meta property="profile:first_name" content="Naman" />}
{isHome && <meta property="profile:last_name" content="Goyal" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Icons & manifest -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
