---
/**
 * ProjectItem.astro — one project as a compact editorial row: title (linked
 * to its repo when there is one), context, blurb, and tags. Used by both the
 * home page's "Selected work" and the full Projects page.
 */
import type { Project } from "../data/projects";

export interface Props {
  project: Project;
}
const { project } = Astro.props;

const repo = project.links?.find((l) => l.href.includes("github.com"));
---

<article class="proj">
  <div class="proj__head">
    <h3 class="proj__title">
      {repo ? (
        <a class="proj__titlelink" href={repo.href} target="_blank" rel="noopener">
          {project.title}
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      ) : (
        project.title
      )}
    </h3>
    <span class="proj__context">{project.context}</span>
  </div>

  <p class="proj__blurb">{project.blurb}</p>

  <div class="proj__foot">
    <div class="proj__tags">
      {project.tags.map((t) => <span class="chip">{t}</span>)}
    </div>
    {repo && (
      <a class="proj__repo" href={repo.href} target="_blank" rel="noopener" aria-label={`${project.title} on GitHub`}>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
      </a>
    )}
  </div>
</article>

<style>
  .proj {
    padding-block: 20px;
    border-bottom: 1px solid var(--border);
  }
  .proj:last-child { border-bottom: 0; }

  .proj__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .proj__title { font-size: 1.02rem; }
  .proj__titlelink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s var(--ease);
  }
  .proj__titlelink svg { color: var(--text-faint); }
  .proj__titlelink:hover { color: var(--accent-ink); }
  .proj__context {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .proj__blurb {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 12px;
    max-width: 68ch;
  }

  .proj__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .proj__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .proj__repo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.15s var(--ease);
  }
  .proj__repo:hover { color: var(--accent-ink); }
</style>
