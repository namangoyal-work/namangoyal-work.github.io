---
/**
 * Footer.astro — contact links + page links. The footer doubles as the
 * contact section on every page, so no dedicated contact page is needed.
 */
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__contact">
      <p class="footer__name">{site.name}</p>
      <p class="footer__note">
        Open to research collaborations and quantitative, software, and hardware
        internships. The fastest way to reach me is email.
      </p>
      <p>
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <nav class="footer__links" aria-label="Footer">
      <div class="footer__col">
        <p class="footer__h">Pages</p>
        {site.nav.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="footer__col">
        <p class="footer__h">Elsewhere</p>
        <a href={site.socials.github} target="_blank" rel="noopener">GitHub</a>
        <a href={site.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={site.resume} target="_blank" rel="noopener">Résumé (PDF)</a>
      </div>
    </nav>
  </div>

  <div class="container footer__meta">
    <p>© {year} {site.name} · {site.location}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding-block: clamp(36px, 6vw, 56px) 24px;
    margin-top: clamp(40px, 8vw, 72px);
  }
  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }
  .footer__contact { max-width: 40ch; }
  .footer__name { font-weight: 600; margin-bottom: 8px; }
  .footer__note {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 10px;
  }

  .footer__links { display: flex; gap: 56px; }
  .footer__col { display: flex; flex-direction: column; gap: 8px; }
  .footer__h {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin-bottom: 4px;
  }
  .footer__col a {
    font-size: 0.92rem;
    color: var(--text-muted);
    transition: color 0.15s var(--ease);
  }
  .footer__col a:hover { color: var(--text); }

  .footer__meta {
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.85rem;
  }
</style>
